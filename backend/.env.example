# Environment Variables
# Copy this file to .env and fill in the values

# Backend configuration
PORT=5000
JWT_SECRET=your_secret_key_change_in_production
NODE_ENV=development

# PostgreSQL connection string
# Local example:  postgresql://user:password@localhost:5432/todolistdb
# Heroku sets this automatically when you add the PostgreSQL addon
DATABASE_URL=postgresql://user:password@localhost:5432/todolistdb
